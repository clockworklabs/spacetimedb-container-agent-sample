{
  "name": "container-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.js",
    "typecheck": "tsc --noEmit",
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetimedb --yes"
  },
  "dependencies": {
    "spacetimedb": "^2.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.6.2"
  }
}
